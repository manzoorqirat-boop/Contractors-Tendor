# Copy these into the Railway service's Variables. Never commit a real .env.

# --- Required -------------------------------------------------------------------------------------------------
# Who receives the digest. Commas, semicolons or spaces between addresses. Change it any time; no redeploy of code.
RECIPIENTS=person1@example.com,person2@example.com
# Brevo API key (create under Brevo > SMTP & API > API keys). Add it as a SECRET variable on Railway.
BREVO_API_KEY=
# Must be a sender address you have verified in Brevo.
MAIL_FROM=tenders@yourdomain.com
MAIL_FROM_NAME=Tender Digest

# Login username for the page (default: admin). Not secret, but change it from the default.
# APP_USERNAME=admin

# --- Strongly recommended --------------------------------------------------------------------------------------
# Where the "already sent" memory lives. Point it at a Railway Volume mounted at /data, or every run starts afresh.
STATE_PATH=/data/tender_state.db

# --- AI summaries (optional) ----------------------------------------------------------------------------------
# Adds a "Summarise with Claude" button to the tender panel. Leave ANTHROPIC_API_KEY empty to keep it off. SECRET on Railway.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5        # optional: summaries, bid briefs, document reading
# ANTHROPIC_FAST_MODEL=claude-haiku-5-5    # optional: bulk work-type tagging and fit scores (cheaper)
# AI_MAX_PER_RUN=150                       # optional: most tenders labelled per run, to cap cost

# --- Optional --------------------------------------------------------------------------------------------------
# PORTALS=maharashtra,delhi,up,central   # which portals to read (default: all four)
# MIN_VALUE=500000                       # ignore tenders worth less than this many rupees (no stated value is kept)
# LOOKBACK_DAYS=2                        # on the first run, only tenders published in the last N days
# CLOSING_SOON_DAYS=3                    # "closing soon" window
# MAX_NEW_PER_PORTAL=25                  # rows shown per portal in the email body (the spreadsheet has them all)
# SUBJECT_PREFIX=Civil tenders
# SEND_EMPTY=true                        # false: stay silent on days with nothing new
# CIVIL_KEYWORDS=...                     # regex; replaces the built-in list of civil-work words
# EXCLUDE_KEYWORDS=...                   # regex; tenders matching this are dropped
# ORG_INCLUDE=...                        # regex; which departments' lists are downloaded
# TZ_NAME=Asia/Kolkata
